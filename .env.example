# === Lafie — environnement (TEMPLATE versionné) ===
# Copier en `.env` à la racine : `cp .env.example .env` puis ajuster.
# Fichier unique et centralisé lu par docker-compose pour l'interpolation ${VAR}.
# Le `.env` réel est gitignored. Toutes les variables ont un défaut dans
# docker-compose.yml : un `.env` absent => la stack démarre avec les défauts (production).

# --- PostgreSQL (runtime) ---
POSTGRES_USER=lafie
POSTGRES_PASSWORD=lafie
POSTGRES_DB=lafie
# Port hôte (5432 souvent occupé par Laragon).
POSTGRES_PORT=5433

# --- API .NET (runtime) ---
ASPNETCORE_ENVIRONMENT=Development
# Port hôte de l'API (8080 souvent pris).
API_PORT=8081

# JWT — DEV uniquement. Générer une vraie clé (>= 32 caractères) hors dev.
JWT_ISSUER=lafie
JWT_AUDIENCE=lafie
JWT_SIGNING_KEY=change-me-dev-signing-key-min-32-characters
JWT_ACCESS_TOKEN_MINUTES=480

# --- Web ---
# Port hôte du client web (runtime). En dev on utilise souvent 3002.
WEB_PORT=3000
# BUILD-TIME : 'development' => PWA désactivée + conf nginx no-cache ;
# 'production' => PWA + cache optimisé. ⚠️ Appliqué au BUILD, pas au `up` :
# après modification, relancer `docker compose build web`.
APP_ENV=production
